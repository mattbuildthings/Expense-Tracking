# Copy to .env.local and fill in. .env / .env.local are gitignored -- keep them
# that way. Never commit a real value from this file.

# ---------------------------------------------------------------------------
# Server-side only (Vercel serverless). NEVER prefix these with VITE_.
# Anything named VITE_* is inlined into the browser bundle by Vite and is
# therefore public.
# ---------------------------------------------------------------------------

# Google Gemini key used by api/ocr.ts for invoice OCR. Server-side only:
# api/ocr.ts no longer accepts a key from the request body, and it no longer
# reads any VITE_-prefixed or alternately-spelled fallback.
GEMINI_API_KEY=

# Optional. Pins the Gemini model api/ocr.ts calls. Leave BLANK to use the
# `gemini-flash-latest` alias, which Google repoints to its current stable
# Flash model -- that is the safer default, because dated snapshots get
# retired (a retired `gemini-1.5-flash` once 404'd three Siteop routes for
# days, and `gemini-3.6-flash` retires 19 Nov 2026).
#
# To move onto Gemini 4 Hydrogen, confirm its exact id against your own key
# first -- run ./scripts/list-gemini-models.sh -- then put that id here.
# Do not guess the string.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Client-side (public -- inlined into the JS bundle, visible to anyone).
#
# Cloud sync is OPT-IN and is off unless both of these are set. There are no
# hardcoded fallbacks any more: a working URL + anon key were previously
# committed to this public repo while the app signed nobody in, so every
# request ran as the `anon` role and anyone reading the repo had the same
# read/write access to `expenses`. See
# supabase/migrations/20261117_lock_down_anon_access.sql.
#
# Leaving these blank is a safe, fully functional configuration: the app runs
# on localStorage + IndexedDB and every Supabase helper returns null.
#
# Do NOT set these again until row-level security and a real authenticated
# user are in place. An anon key is public by design -- RLS plus auth is the
# security boundary, not the secrecy of the key.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
